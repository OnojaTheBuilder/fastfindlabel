---
import '../styles/global.css';
import { C } from '../data/content.js';
const { title = `${C.brand} – Phone Return Labels for Lost Phones`, description = C.seoDescription, path = '/', schema = null } = Astro.props;
const url = `https://fastfindlabel.com${path}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" /><meta property="og:url" content={url} />
<meta property="og:title" content={`${C.brand} · ${C.tagline}`} />
<meta property="og:description" content={description} /><meta property="og:site_name" content={C.brand} />
<meta property="og:image" content="https://fastfindlabel.com/images/social-preview.jpg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Fast Find Label sticker on a phone case, from $10" /><meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#F3F8EE" />
{path === '/404/' && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,900&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
<main><slot /></main>
<footer><div class="pol">{C.policies.map((p) => <details><summary>{p.t}</summary>{p.body.map((x) => <p>{x}</p>)}</details>)}<p class="upd">{C.policyNote}</p></div><p class="legal"><a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms, Shipping &amp; Returns</a></p>{C.about && <p class="about">{C.about}</p>}<p>Contact: <a href={`mailto:${C.email}`}>{C.email}</a></p><p>{C.foot}</p></footer>
<script>import '../scripts/client.js';</script>
</body>
</html>
