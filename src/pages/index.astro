---
import Base from '../layouts/Base.astro';
import { C } from '../data/content.js';
const f = C.form, m = C.map;
const telPat = String.raw`\(\d{3}\) \d{3}-\d{4}`, zipPat = String.raw`\d{5}(-?\d{4})?`;
// US states + DC for the State drop-down (value = 2-letter code; must match server/lib.js STATES)
const states = [['AL','Alabama'],['AK','Alaska'],['AZ','Arizona'],['AR','Arkansas'],['CA','California'],['CO','Colorado'],['CT','Connecticut'],['DE','Delaware'],['DC','District of Columbia'],['FL','Florida'],['GA','Georgia'],['HI','Hawaii'],['ID','Idaho'],['IL','Illinois'],['IN','Indiana'],['IA','Iowa'],['KS','Kansas'],['KY','Kentucky'],['LA','Louisiana'],['ME','Maine'],['MD','Maryland'],['MA','Massachusetts'],['MI','Michigan'],['MN','Minnesota'],['MS','Mississippi'],['MO','Missouri'],['MT','Montana'],['NE','Nebraska'],['NV','Nevada'],['NH','New Hampshire'],['NJ','New Jersey'],['NM','New Mexico'],['NY','New York'],['NC','North Carolina'],['ND','North Dakota'],['OH','Ohio'],['OK','Oklahoma'],['OR','Oregon'],['PA','Pennsylvania'],['RI','Rhode Island'],['SC','South Carolina'],['SD','South Dakota'],['TN','Tennessee'],['TX','Texas'],['UT','Utah'],['VT','Vermont'],['VA','Virginia'],['WA','Washington'],['WV','West Virginia'],['WI','Wisconsin'],['WY','Wyoming']];
const route = m.stops.map((s, i) => `${i ? 'L' : 'M'}${s.x} ${s.y}`).join(' ');
// Structured data for Google (prices come from content.js; no ratings or reviews until real ones exist).
const SITE = 'https://fastfindlabel.com/';
const shipping = { '@type': 'OfferShippingDetails', shippingRate: { '@type': 'MonetaryAmount', value: C.shipping, currency: 'USD' },
  shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' } };
const returns = { '@type': 'MerchantReturnPolicy', applicableCountry: 'US', returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted' };
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: C.brand, url: SITE },
  { '@context': 'https://schema.org', '@type': 'Organization', name: C.brand, url: SITE, email: C.email },
  { '@context': 'https://schema.org', '@type': 'Product', name: `${C.brand} phone return labels`, brand: { '@type': 'Brand', name: C.brand },
    description: 'Adhesive, thermal-printed, waterproof labels for the back of a phone or case, printed with the phone number of someone you trust so whoever finds a lost phone has a number to call.',
    image: C.images.map((i) => new URL(i.src, SITE).href), url: SITE,
    offers: C.price.map((p) => ({ '@type': 'Offer', name: `${p.q} labels`, price: p.p, priceCurrency: 'USD', availability: 'https://schema.org/InStock',
      url: SITE, itemCondition: 'https://schema.org/NewCondition', shippingDetails: shipping, hasMerchantReturnPolicy: returns })) }
];
---
<Base schema={schema}>
<header><h1>{C.brand}</h1><p class="tag"><button type="button" id="mapOpen" class="taglink" aria-haspopup="dialog">{C.tagline}</button></p></header>
<section class="what">{C.intro.map((t) => <p set:html={t} />)}</section>
<section class="pics">{C.images.map((i) => <img src={i.src} alt={i.alt} width={i.w} height={i.h} decoding="async" />)}</section>
<section id="order" class="get">
<h2>{C.get}</h2>
<p class="ship">{C.shipNote}<br />{C.delivery}</p>
<p class="trust">{C.trust}</p>
<p class="paused" id="paused" role="status" hidden>{C.pausedNote}</p>
<p class="fac"><button type="button" id="facToggle" class="taglink" aria-controls="of" aria-pressed="false">{C.facility.link}</button></p>
<form id="of">
<input type="hidden" name="facility" id="facFlag" value="" />
<p class="facnote" id="facNote" hidden>{C.facility.note}</p>
<fieldset><legend>{f.choose}</legend>{C.price.map((p, i) => <label class="opt"><input type="radio" name="pack" value={i} checked={i === 0} /> <span data-q={p.q} data-p={p.p}>{p.q} labels ${p.p} + ${C.shipping} shipping</span></label>)}</fieldset>
<label class="f">{f.tel}<input id="tn" name="tel" type="tel" inputmode="tel" required pattern={telPat} placeholder="(555) 555-5555" autocomplete="off" /><small set:html={f.telHint}></small></label>
<label class="f">{f.name}<input name="name" type="text" required autocomplete="name" /></label>
<label class="f">{f.email}<input name="email" type="email" required autocomplete="email" /></label>
<label class="f" id="facNameWrap" hidden>{C.facility.name}<input id="facName" name="facilityName" type="text" maxlength="100" autocomplete="organization" /></label>
<div class="g2"><label class="f">{f.street}<input name="street" type="text" required autocomplete="address-line1" /></label><label class="f"><span id="aptLabel">{f.apt}</span><input name="apt" type="text" autocomplete="address-line2" /></label></div>
<div class="g3"><label class="f">{f.city}<input name="city" type="text" required autocomplete="address-level2" /></label><label class="f">{f.state}<select name="state" required autocomplete="address-level1"><option value="">Select</option>{states.map(([a, n]) => <option value={a}>{n} ({a})</option>)}</select></label><label class="f">{f.zip}<input name="zip" type="text" required inputmode="numeric" pattern={zipPat} maxlength="10" autocomplete="postal-code" /></label></div>
<p class="total">{f.total}: <strong id="tot" aria-live="polite"></strong></p>
<button class="btn" type="submit">{f.pay}</button>
<div id="pp"></div>
</form>
<div id="done" role="status" hidden></div>
</section>
<dialog id="map" aria-labelledby="mapT">
<h2 id="mapT">{m.title}</h2>
<svg viewBox="0 0 300 180" role="img" aria-label="Route map with six stops">
<path d={route} class="route" />
{m.stops.map((s, i) => <g><circle cx={s.x} cy={s.y} r="7" class="pin" /><text x={s.x} y={s.y + (i % 2 ? -13 : 22)} text-anchor="middle">{s.name}</text></g>)}
<g id="dot"><rect x="-6" y="-10" width="12" height="20" rx="3" /><rect x="-4" y="5" width="8" height="2" class="lbl" /></g>
</svg>
<p id="mapTip" aria-live="polite"></p>
<div class="mapnav"><button type="button" class="btn sm" id="mapBack">{m.back}</button><span id="mapStep"></span><button type="button" class="btn sm" id="mapNext">{m.next}</button></div>
<button type="button" class="x" id="mapClose" aria-label={m.close}>×</button>
</dialog>
</Base>
