---
import Base from '../layouts/Base.astro';
import { C } from '../data/content.js';
const f = C.form, m = C.map;
const telPat = String.raw`\(\d{3}\) \d{3}-\d{4}`, zipPat = String.raw`\d{5}`, statePat = '[A-Za-z]{2}';
const route = m.stops.map((s, i) => `${i ? 'L' : 'M'}${s.x} ${s.y}`).join(' ');
---
<Base>
<header><h1>{C.brand}</h1><p class="tag"><button type="button" id="mapOpen" class="taglink" aria-haspopup="dialog">{C.tagline}</button></p></header>
<section class="what">{C.intro.map((t) => <p set:html={t} />)}</section>
<section class="pics">{C.images.map((i) => <img src={i.src} alt={i.alt} width={i.w} height={i.h} />)}</section>
<section id="order" class="get">
<h2>{C.get}</h2>
<p class="ship">{C.shipNote}<br />{C.delivery}</p>
<p class="trust">{C.trust}</p>
<p class="paused" id="paused" role="status" hidden>{C.pausedNote}</p>
<form id="of">
<fieldset><legend>{f.choose}</legend>{C.price.map((p, i) => <label class="opt"><input type="radio" name="pack" value={i} checked={i === 0} /> <span>{p.q} labels ${p.p} + ${C.shipping} shipping</span></label>)}</fieldset>
<label class="f">{f.tel}<input id="tn" name="tel" type="tel" inputmode="tel" required pattern={telPat} placeholder="(555) 555-5555" autocomplete="off" /><small set:html={f.telHint}></small></label>
<label class="f">{f.name}<input name="name" type="text" required autocomplete="name" /></label>
<label class="f">{f.email}<input name="email" type="email" required autocomplete="email" /></label>
<div class="g2"><label class="f">{f.street}<input name="street" type="text" required autocomplete="address-line1" /></label><label class="f">{f.apt}<input name="apt" type="text" autocomplete="address-line2" /></label></div>
<div class="g3"><label class="f">{f.city}<input name="city" type="text" required autocomplete="address-level2" /></label><label class="f">{f.state}<input name="state" type="text" required maxlength="2" pattern={statePat} placeholder="OH" autocomplete="address-level1" /></label><label class="f">{f.zip}<input name="zip" type="text" required inputmode="numeric" pattern={zipPat} maxlength="5" autocomplete="postal-code" /></label></div>
<p class="total">{f.total}: <strong id="tot" aria-live="polite"></strong></p>
<button class="btn" type="submit">{f.pay}</button>
<div id="pp"></div>
</form>
<div id="done" role="status" hidden></div>
</section>
<dialog id="map" aria-labelledby="mapT">
<h2 id="mapT">{m.title}</h2>
<svg viewBox="0 0 300 180" role="img" aria-label="Route map with six stops">
<path d={route} class="route" />
{m.stops.map((s, i) => <g><circle cx={s.x} cy={s.y} r="7" class="pin" /><text x={s.x} y={s.y + (i % 2 ? -13 : 22)} text-anchor="middle">{s.name}</text></g>)}
<g id="dot"><rect x="-6" y="-10" width="12" height="20" rx="3" /><rect x="-4" y="5" width="8" height="2" class="lbl" /></g>
</svg>
<p id="mapTip" aria-live="polite"></p>
<div class="mapnav"><button type="button" class="btn sm" id="mapBack">{m.back}</button><span id="mapStep"></span><button type="button" class="btn sm" id="mapNext">{m.next}</button></div>
<button type="button" class="x" id="mapClose" aria-label={m.close}>×</button>
</dialog>
</Base>
